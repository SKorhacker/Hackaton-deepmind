# Copy to .env.local (gitignored) and fill in. The key is read only in dev mode —
# `npm run build` never bakes it into the bundle.
# Get one at https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=
# Optional, defaults to gemini-3.8-flash
VITE_GEMINI_MODEL=gemini-3.8-flash

# Or OpenAI (used when no Gemini key is set)
VITE_OPENAI_API_KEY=
# Optional, defaults to gpt-4.1-mini
VITE_OPENAI_MODEL=gpt-4.1-mini
